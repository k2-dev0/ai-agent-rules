# sandbox内の単一通常commandはpermission profileに委ねる。複合構文・Git引数はhookで検査する。
# allowはsandbox外でも適用されるため、契約付きGitと固定の特権scriptだけに限定する。

prefix_rule(
    pattern = ["bash", ".agents/skills/bootstrap/bootstrap.sh", "codex"],
    decision = "allow",
    justification = "配置済みCodex設定のplaceholderを決定的スクリプトで解決します。",
)

prefix_rule(
    pattern = ["bash", ".agents/skills/tdd/mark-prompt-done.sh"],
    decision = "allow",
    justification = "実装済みの設計書を固定の.codex/prompt/.prompt.md上で[x]に倒します。",
)

prefix_rule(
    pattern = ["bash", ".agents/skills/e2e/apply-e2e-plan.sh"],
    decision = "allow",
    justification = "確認済み計画を固定の.codex/e2e/.e2e.mdへ反映します。",
)

prefix_rule(
    pattern = ["bash", ".agents/skills/rebase/rebase.sh"],
    decision = "allow",
    justification = "明示的なrebase呼び出しで、未push履歴だけを固定スクリプトで二重検証して整理します。",
)

prefix_rule(
    pattern = ["bash", ".codex/hooks/shell/protect-review.sh", "approve"],
    decision = "prompt",
    justification = "レビュー対象ファイルへの次の1回の変更を許可するか確認します。",
    match = [
        "bash .codex/hooks/shell/protect-review.sh approve apps/api/infra/main.tf",
    ],
    not_match = [
        "bash .codex/hooks/shell/protect-review.sh apps/api/infra/main.tf",
    ],
)

prefix_rule(
    pattern = ["git", ["reset", "clean", "restore", "checkout", "switch", "rebase", "merge", "fetch", "pull", "clone", "init", "config", "update-ref", "gc", "prune", "reflog", "stash", "apply", "am", "rm", "mv"]],
    decision = "forbidden",
    justification = "このGit操作は許可されていません。履歴整理は固定rebaseスクリプトを使ってください。",
)

prefix_rule(
    pattern = ["git", ["add", "commit"]],
    decision = "allow",
    justification = "共有hookが単一file・commit契約を検査するadd/commitを許可します。",
)

prefix_rule(
    pattern = ["git", "--no-pager", "--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false", "-c", "core.hooksPath=/dev/null", "-c", "status.submoduleSummary=false", "--literal-pathspecs", "add", "--"],
    decision = "allow",
    justification = "単一fileを検査したstageを実行します。",
)

prefix_rule(
    pattern = ["git", "--no-pager", "--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false", "-c", "core.hooksPath=/dev/null", "-c", "status.submoduleSummary=false", "-c", "commit.gpgSign=false", "commit", "-m"],
    decision = "allow",
    justification = "外部hookと署名programを無効にした契約準拠commitを実行します。",
)

prefix_rule(
    pattern = ["git", "--no-pager", "--no-optional-locks", "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false", "-c", "core.hooksPath=/dev/null", "-c", "status.submoduleSummary=false", "restore", "--staged"],
    decision = "allow",
    justification = "hookで検査したindexだけの復元を許可します。作業ファイルとHEADは変更しません。",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "pushはユーザー自身が変更内容を確認して実行してください。",
)

prefix_rule(
    pattern = ["git", "cherry-pick"],
    decision = "forbidden",
    justification = "履歴の取り込みはユーザー自身が実行してください。",
)

prefix_rule(
    pattern = ["bash", ".codex/hooks/shell/outside.sh"],
    decision = "prompt",
    justification = "Git保護を維持した境界外実行の承認を求めます。",
)
