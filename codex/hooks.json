{
  "description": "Project guardrails shared by the distributed Codex configuration.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/session.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/session.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/readonly-search.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-git.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-config.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-env.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-review.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-locks.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/load-required-contract.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/readonly-search.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/shell-file-write.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-eval.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-registry.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-migration.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-history.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-git.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-config.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-env.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-review.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-locks.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/commit-gate.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(^Agent$|(^|[._])(spawn_agent|spawn_agents_on_csv|resume_agent)$|^collaboration(spawn_agent|spawn_agents_on_csv|resume_agent)$)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/require-implementer.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(^|[._])(wait|wait_agent)$|^collaboration(wait|wait_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/agent-wait.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|Read|Grep|exec_command)$|(^|[._])(read_file|read_text_file|read_multiple_files|get_file_contents|read_resource|search_for_pattern|find_symbol|get_symbols_overview|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-skill-source.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|apply_patch|Agent)$|(^|[._])spawn_agent$|^collaborationspawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|deep-reviewer)$"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|deep-reviewer)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
