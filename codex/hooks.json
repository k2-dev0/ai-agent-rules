{
  "description": "Project guardrails shared by the distributed Codex configuration.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/session.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/session.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/pre-model-switch.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|mcp__baton__switch_model)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/command-approval.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|apply_patch|Edit|Write|MultiEdit|NotebookEdit|Agent)$|(^|[._])spawn_agent$|^collaborationspawn_agent$|^mcp__deepseek[-_]worker__(start_task|continue_task|wait_task|abort_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deepseek-worker.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-git.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-config.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-env.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-review.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-locks.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/load-required-contract.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/agent-input.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-git.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-config.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-env.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-locks.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(^Agent$|(^|[._])(spawn_agent|spawn_agents_on_csv|resume_agent|followup_task)$|^collaboration(spawn_agent|spawn_agents_on_csv|resume_agent|followup_task)$|^((functions|collaboration)[._])?(send_input|send_message|send_message_to_agent)$|^collaboration(send_input|send_message|send_message_to_agent)$)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/require-implementer.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "(^|[._])(wait|wait_agent)$|^collaboration(wait|wait_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/agent-wait.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|Read|Grep|exec_command)$|(^|[._])(read_file|read_text_file|read_multiple_files|get_file_contents|read_resource|search_for_pattern|find_symbol|get_symbols_overview|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deny-skill-source.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|Edit|Write|MultiEdit|NotebookEdit|apply_patch|Agent)$|(^|[._])spawn_agent$|^collaborationspawn_agent$|^mcp__deepseek[-_]worker__(start_task|continue_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__chrome[-_]devtools__(take_screenshot|take_snapshot|screencast_start)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/protect-git.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__deepseek[-_]worker__(start_task|continue_task|wait_task|abort_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/deepseek-worker.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/load-operation-context.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|code-reviewer-critical|design-reviewer)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|code-reviewer-critical)$"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(code-reviewer|code-reviewer-critical)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/agent-input.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/shell/independent-review.sh\"",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|code-reviewer-critical)$"
      }
    ]
  }
}
