{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/session.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/session.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
        {
          "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-eval.sh"
        },
        {
          "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-registry.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-migration.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/deny-history.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-git.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-locks.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/commit-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/load-required-contract.sh"
          }
        ]
      },
    {
      "matcher": "Write",
      "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/overwrite.sh"
        }
      ]
    },
    {
      "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-git.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/shell/protect-locks.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "bash .claude/skills/bootstrap/init-agent.sh",
      "bash .claude/skills/bootstrap/init-agent.sh *",
      "bash .claude/skills/cowlick/apply-prompt.sh",
      "bash .claude/skills/cowlick/apply-prompt.sh *",
      "bash .claude/skills/tdd/mark-prompt-done.sh",
      "bash .claude/skills/tdd/mark-prompt-done.sh *",
      "bash .claude/skills/polish/quality-gate.sh",
      "bash .claude/skills/polish/quality-gate.sh *",
      "bash .claude/skills/rebase/rebase.sh",
      "bash .claude/skills/rebase/rebase.sh *",
      "bash .claude/skills/deepseek/delegate.sh",
      "bash .claude/skills/deepseek/delegate.sh *",
      "bash .claude/skills/e2e/apply-e2e-plan.sh",
      "bash .claude/skills/e2e/apply-e2e-plan.sh *"
    ],
    "filesystem": {
      "denyWrite": [".git/hooks", ".git/config", ".env", ".env.*", ".claude"]
    },
    "network": {
      "allowLocalBinding": false,
      "allowedDomains": []
    }
  }
}
