{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/shell-file-write.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/deny-eval.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/deny-registry.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/deny-migration.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/deny-history.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-git.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-config.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-locks.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/overwrite.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-config.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-review.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-git.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-env.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-locks.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/load-required-contract.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/require-implementer.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/load-operation-context.sh"
          }
        ]
      },
      {
        "matcher": "^(Bash|Read|Grep|exec_command)$|(^|[._])(read_file|read_text_file|read_multiple_files|get_file_contents|read_resource|search_for_pattern|find_symbol|get_symbols_overview|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/deny-skill-source.sh"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|apply_patch|Agent)$|(^|[._])spawn_agent$|^collaborationspawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/independent-review.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__(chrome[-_]devtools__(take_screenshot|take_snapshot|screencast_start)|serena__write_memory)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/protect-git.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/independent-review.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/load-operation-context.sh",
            "timeout": 5
          }
        ],
        "matcher": "^(difficulty-evaluator|code-reviewer|deep-reviewer|design-reviewer|nesting-reviewer)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/independent-review.sh",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|deep-reviewer)$"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/shell/independent-review.sh",
            "timeout": 5
          }
        ],
        "matcher": "^(code-reviewer|deep-reviewer)$"
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "bash .claude/skills/bootstrap/bootstrap.sh",
      "bash .claude/skills/bootstrap/bootstrap.sh *",
      "bash .claude/skills/tdd/mark-prompt-done.sh",
      "bash .claude/skills/tdd/mark-prompt-done.sh *",
      "bash .claude/skills/rebase/rebase.sh",
      "bash .claude/skills/rebase/rebase.sh *",
      "bash .claude/skills/e2e/apply-e2e-plan.sh",
      "bash .claude/skills/e2e/apply-e2e-plan.sh *"
    ],
    "filesystem": {
      "denyWrite": [
        ".git",
        ".env",
        ".env.*",
        ".mcp.json",
        ".claude/hooks",
        ".claude/agents",
        ".claude/skills",
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".codex/hooks",
        ".codex/agents",
        ".codex/config.toml",
        ".codex/hooks.json",
        ".agents/skills"
      ]
    },
    "network": {
      "allowLocalBinding": false,
      "allowedDomains": []
    }
  }
}
