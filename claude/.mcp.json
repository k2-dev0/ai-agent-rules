{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@29d07d4f6b7a04a0db3981d6c6be6f736cfb44d2",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    },
    "context-dictionary": {
      "type": "stdio",
      "command": "__CONTEXT_DICTIONARY_ROOT__/node_modules/.bin/tsx",
      "args": [
        "__CONTEXT_DICTIONARY_ROOT__/src/mcp/stdio.ts"
      ],
      "env": {
        "CONTEXT_AGENT": "claude"
      }
    }
  }
}
