{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "bash",
      "args": [
        ".claude/hooks/shell/mcp-protected.sh",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--workspace=.",
        "--experimentalScreencast=true",
        "--allowed-url-pattern=*://localhost:*/*",
        "--allowed-url-pattern=*://127.0.0.1:*/*",
        "--allowed-url-pattern=*://[\\:\\:1]:*/*"
      ]
    },
    "context-dictionary": {
      "type": "stdio",
      "command": "bash",
      "args": [
        ".claude/hooks/shell/mcp-protected.sh",
        "__CONTEXT_DICTIONARY_ROOT__/node_modules/.bin/tsx",
        "__CONTEXT_DICTIONARY_ROOT__/src/mcp/stdio.ts"
      ],
      "env": {
        "CONTEXT_AGENT": "claude"
      }
    }
  }
}
